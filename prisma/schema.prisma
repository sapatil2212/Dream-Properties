// This is your Prisma schema file
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Enums
enum UserRole {
  USER
  BUILDER
  ADMIN
  SUPER_ADMIN
  SAAS_OWNER
  TELECALLER
  SALES_EXECUTIVE
  BUYER
}

enum UserStatus {
  Active
  Disabled
  Deleted
}

enum PropertyStatus {
  Pending_Approval @map("Pending Approval")
  Approved
  Rejected
}

enum ListingType {
  Sell
  Rent
  Lease
}

// Models
model User {
  id               Int       @id @default(autoincrement())
  name             String    @db.VarChar(255)
  firstName        String?   @map("first_name") @db.VarChar(255)
  lastName         String?   @map("last_name") @db.VarChar(255)
  email            String    @unique @db.VarChar(255)
  mobile           String    @db.VarChar(20)
  password         String    @db.VarChar(255)
  role             String    @default("USER") @db.VarChar(50)
  dob              String?   @db.VarChar(20)
  gender           String?   @db.VarChar(20)
  address          String?   @db.Text
  occupation       String?   @db.VarChar(100)
  experienceYears  Int?      @default(0) @map("experience_years")
  experienceMonths Int?      @default(0) @map("experience_months")
  isFresher        Boolean   @default(false) @map("is_fresher")
  propertyType     String?   @map("property_type") @db.VarChar(50)
  lookingTo        String?   @map("looking_to") @db.VarChar(50)
  projectName      String?   @map("firm_name") @db.VarChar(255)
  propertyAddress  String?   @map("office_address") @db.Text
  securityKey      String?   @map("security_key") @db.VarChar(50)
  status           UserStatus @default(Active)
  lastActiveAt     DateTime?  @map("last_active_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  
  properties       Property[]
  favorites        Favorite[]
  assignedLeads    Lead[]    @relation("AssignedLeads")
  assignedInquiries ContactInquiry[] @relation("AssignedInquiries")
  salesExecInquiries ContactInquiry[] @relation("SalesExecutiveInquiries")
  siteVisits       SiteVisit[] @relation("StaffVisits")
  salesExecLeads   Lead[]    @relation("SalesExecutiveLeads")
  
  employeeProfile  EmployeeProfile?
  attendance       Attendance[]
  leaveRequests    LeaveRequest[]
  salarySlips      SalarySlip[]

  @@map("users")
}

model PendingUser {
  email            String    @id @db.VarChar(255)
  name             String    @db.VarChar(255)
  firstName        String?   @map("first_name") @db.VarChar(255)
  lastName         String?   @map("last_name") @db.VarChar(255)
  mobile           String    @db.VarChar(20)
  password         String    @db.VarChar(255)
  role             String    @default("USER") @db.VarChar(50)
  dob              String?   @db.VarChar(20)
  gender           String?   @db.VarChar(20)
  address          String?   @db.Text
  occupation       String?   @db.VarChar(100)
  experienceYears  Int?      @default(0) @map("experience_years")
  experienceMonths Int?      @default(0) @map("experience_months")
  isFresher        Boolean   @default(false) @map("is_fresher")
  propertyType     String?   @map("property_type") @db.VarChar(50)
  lookingTo        String?   @map("looking_to") @db.VarChar(50)
  projectName      String?   @map("firm_name") @db.VarChar(255)
  propertyAddress  String?   @map("office_address") @db.Text
  securityKey      String?   @map("security_key") @db.VarChar(50)
  status           UserStatus @default(Active)
  otp              String    @db.VarChar(6)
  expiresAt        DateTime  @map("expires_at")
  
  @@map("pending_users")
}

model Property {
  id                Int             @id @default(autoincrement())
  builderId         Int             @map("builder_id")
  title             String          @db.VarChar(255)
  description       String?         @db.Text
  price             String?         @db.VarChar(100)
  area              String?         @db.VarChar(100)
  location          String?         @db.VarChar(255)
  address           String?         @db.Text
  type              String?         @db.VarChar(50)
  status            PropertyStatus  @default(Pending_Approval)
  isFeatured        Boolean         @default(false) @map("is_featured")
  bedrooms          Int?
  bathrooms         Int?
  possessionDate    String?         @map("possession_date") @db.VarChar(50)
  reraId            String?         @map("rera_id") @db.VarChar(100)
  amenities         Json?
  images            Json?
  highlights        Json?
  specifications    Json?
  projectUnits      Int?            @map("project_units")
  projectArea       String?         @map("project_area") @db.VarChar(100)
  configurations    String?         @db.VarChar(255)
  avgPrice          String?         @map("avg_price") @db.VarChar(100)
  launchDate        String?         @map("launch_date") @db.VarChar(50)
  sizes             String?         @db.VarChar(255)
  projectSize       String?         @map("project_size") @db.VarChar(255)
  areaUnit          String?         @map("area_unit") @db.VarChar(50)
  propertySubtype   String?         @map("property_subtype") @db.VarChar(100)
  mapLink           String?         @map("map_link") @db.Text
  nearbyLocations   Json?           @map("nearby_locations")
  attachments       Json?
  listingType       ListingType     @default(Sell) @map("listing_type")
  
  // Rental-specific fields
  furnishing        String?         @db.VarChar(50)
  listedBy          String?         @map("listed_by") @db.VarChar(50)
  bachelorsAllowed  String?         @map("bachelors_allowed") @db.VarChar(10)
  carpetArea        String?         @map("carpet_area") @db.VarChar(100)
  maintenance       String?         @db.VarChar(100)
  totalFloors       String?         @map("total_floors") @db.VarChar(50)
  carParking        String?         @map("car_parking") @db.VarChar(50)
  
  views             Int             @default(0)
  propertyFlag      String?         @map("property_flag") @db.VarChar(20)
  flaggedAt         DateTime?       @map("flagged_at")
  flaggedBy         Int?            @map("flagged_by")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  
  builder           User            @relation(fields: [builderId], references: [id], onDelete: Cascade)
  favorites         Favorite[]
  leads             Lead[]
  siteVisits        SiteVisit[]
  
  @@map("properties")
}

model Favorite {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  propertyId  Int      @map("property_id")
  createdAt   DateTime @default(now()) @map("created_at")
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  @@unique([userId, propertyId], map: "user_property")
  @@map("favorites")
}

model Lead {
  id                 Int      @id @default(autoincrement())
  name               String   @db.VarChar(255)
  email              String   @db.VarChar(255)
  phone              String   @db.VarChar(20)
  propertyId         Int      @map("property_id")
  propertyOfInterest String   @map("property_of_interest") @db.VarChar(255)
  status             String   @default("New") @db.VarChar(50)
  source             String   @default("Website") @db.VarChar(50)
  lastNote           String?  @map("last_note") @db.Text
  assignedTo         Int?     @map("assigned_to")
  salesExecutiveId   Int?     @map("sales_executive_id")
  createdAt          DateTime @default(now()) @map("created_at")
  followUpAt         DateTime? @map("follow_up_at")
  lastContactAt      DateTime? @map("last_contact_at")
  
  property           Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  assignedStaff      User?    @relation("AssignedLeads", fields: [assignedTo], references: [id])
  salesExecutive     User?    @relation("SalesExecutiveLeads", fields: [salesExecutiveId], references: [id])
  siteVisits         SiteVisit[]
  
  @@map("leads")
}

model SiteVisit {
  id          Int      @id @default(autoincrement())
  leadId      Int      @map("lead_id")
  propertyId  Int      @map("property_id")
  staffId     Int      @map("staff_id")
  visitDate   DateTime @map("visit_date")
  status      String   @default("Scheduled") @db.VarChar(50)
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  staff       User     @relation("StaffVisits", fields: [staffId], references: [id])

  @@map("site_visits")
}

model Promotion {
  id          Int      @id @default(autoincrement())
  imageUrl    String   @map("image_url") @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("promotions")
}

model ContactInquiry {
  id        Int      @id @default(autoincrement())
  firstName String   @default("") @map("first_name") @db.VarChar(100)
  lastName  String   @default("") @map("last_name") @db.VarChar(100)
  email     String   @db.VarChar(255)
  phone     String   @db.VarChar(20)
  subject   String?  @db.VarChar(255)
  message   String   @db.Text
  interestedIn String?  @map("interested_in") @db.VarChar(255)
  city         String?  @db.VarChar(100)
  state        String?  @db.VarChar(100)
  assignedTo   Int?     @map("assigned_to")
  assignedStaff User?   @relation("AssignedInquiries", fields: [assignedTo], references: [id])
  salesExecutiveId Int? @map("sales_executive_id")
  salesExecutive   User? @relation("SalesExecutiveInquiries", fields: [salesExecutiveId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  
  @@map("contact_inquiries")
}

model Notification {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  type        String   @db.VarChar(50)
  title       String   @db.VarChar(255)
  message     String   @db.Text
  link        String?  @db.VarChar(255)
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")
  
  @@index([userId, isRead])
  @@map("notifications")
}

model EmployeeProfile {
  id              Int       @id @default(autoincrement())
  userId          Int       @unique @map("user_id")
  user            User      @relation(fields: [userId], references: [id])
  designation     String?
  department      String?
  joiningDate     DateTime? @map("joining_date")
  basicSalary     Float     @default(0) @map("basic_salary")
  hra             Float     @default(0)
  allowances      Float     @default(0)
  specialAllowance Float    @default(0) @map("special_allowance")
  medicalAllowance Float    @default(0) @map("medical_allowance")
  pf               Float    @default(0)
  professionalTax  Float    @default(0) @map("professional_tax")
  healthInsurance  Float    @default(0) @map("health_insurance")
  
  // Custom Components (JSON)
  customEarnings   Json?    @map("custom_earnings")
  customDeductions Json?    @map("custom_deductions")

  leavesAllotted  Int       @default(12) @map("leaves_allotted")
  leavesTaken     Int       @default(0) @map("leaves_taken")
  accountNumber   String?   @map("account_number")
  bankName        String?   @map("bank_name")
  ifscCode        String?   @map("ifsc_code")
  
  // Working Hours & Deduction Rules
  workingHours        Float     @default(9) @map("working_hours")
  shiftStartTime      String    @default("09:00") @map("shift_start_time")
  lateMarkDeduction   Float     @default(0) @map("late_mark_deduction")

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  @@map("employee_profiles")
}

model Attendance {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  date      DateTime @db.Date 
  checkIn   DateTime @default(now()) @map("check_in")
  checkOut  DateTime? @map("check_out")
  status    String   @default("Present") 
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, date]) 
  @@map("attendance")
}

model LeaveRequest {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  reason    String   @db.Text
  status    String   @default("Pending") 
  type      String   @default("Paid") 
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  @@map("leave_requests")
}

model SalarySlip {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  user          User     @relation(fields: [userId], references: [id])
  month         Int
  year          Int
  basicSalary   Float    @map("basic_salary")
  hra           Float
  allowances    Float
  deductions    Float    @default(0)
  netSalary     Float    @map("net_salary")
  details       Json?    // Stores full breakdown: basic, hra, special, medical, pf, pt, insurance
  generatedDate DateTime @default(now()) @map("generated_date")
  
  @@map("salary_slips")
}
